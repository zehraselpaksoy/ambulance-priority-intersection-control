<routes>
    <!-- Araç tipi tanımı -->
    <vType id="car" accel="2.6" decel="4.5" sigma="0.5" length="4.5" maxSpeed="13.89" color="yellow"/>

    <!-- 1. Batıdan girip Doğuya giden akış -->
    <flow id="flow_w_e" type="car" begin="0" end="1000" probability="0.25">
        <route edges="-E3 E0"/>
    </flow>

    <!-- 2. Doğudan girip Batıya giden akış -->
    <flow id="flow_e_w" type="car" begin="0" end="1000" probability="0.25">
        <route edges="-E0 E3"/>
    </flow>

    <!-- 3. Kuzeyden girip Güneye giden akış -->
    <flow id="flow_n_s" type="car" begin="0" end="1000" probability="0.15">
        <route edges="-E1 E2"/>
    </flow>

    <!-- 4. Güneyden girip Kuzeye giden akış -->
    <flow id="flow_s_n" type="car" begin="0" end="1000" probability="0.15">
        <route edges="-E2 E1"/>
    </flow>
</routes>